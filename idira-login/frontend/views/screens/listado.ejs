<%- include('../partials/header', { title: 'Listado' }) %>

<h1>Listado</h1>
<p>Permiso <code>listado</code> · tu rol: <code><%= rol %></code></p>

<table>
  <tr><td>id</td><td>asunto</td><td>estado</td></tr>
  <% registros.forEach((r) => { %>
    <tr><td><%= r.id %></td><td><%= r.asunto %></td><td><%= r.estado %></td></tr>
  <% }) %>
</table>
<p class="hint">Datos de ejemplo.</p>

<a class="btn secondary" href="/">Volver al inicio</a>

