<%- include('../partials/header', { title: pantalla.titulo }) %>

<h1><%= pantalla.titulo %></h1>
<p>Pantalla de solo lectura. La pueden ver los roles <code>consulta</code> y <code>admin</code>.</p>

<table>
  <tr><td>usuario</td><td><%= user.usuario %></td></tr>
  <tr><td>nombre</td><td><%= user.nombre || '' %></td></tr>
  <tr><td>rol</td><td><%= rol %></td></tr>
  <tr><td>ingresó con</td><td><%= user.metodo || 'Idira' %></td></tr>
</table>

<h2>Reporte de ejemplo</h2>
<table>
  <tr><td>Solicitudes del mes</td><td>128</td></tr>
  <tr><td>Atendidas</td><td>117</td></tr>
  <tr><td>Pendientes</td><td>11</td></tr>
</table>

<a class="btn secondary" href="/">Volver al inicio</a>

<%- include('../partials/footer') %>
