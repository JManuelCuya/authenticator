<%- include('../partials/header', { title: 'Inventario' }) %>

<h1>Inventario</h1>
<p>Permiso <code>inventario</code> · tu rol: <code><%= rol %></code></p>

<table>
  <tr><td>código</td><td>descripción</td><td>stock</td></tr>
  <% items.forEach((i) => { %>
    <tr><td><%= i.codigo %></td><td><%= i.descripcion %></td><td><%= i.stock %></td></tr>
  <% }) %>
</table>
<p class="hint">Datos de ejemplo.</p>

<a class="btn secondary" href="/">Volver al inicio</a>

