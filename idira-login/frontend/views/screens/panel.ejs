<%- include('../partials/header', { title: 'Panel' }) %>

<h1>Panel</h1>
<p>Permiso <code>panel</code> · tu rol: <code><%= rol %></code></p>

<% if (error) { %><p class="error"><%= error %></p><% } %>

<h2>Roles y permisos</h2>
<% if (matriz.roles.length) { %>
  <table>
    <tr>
      <td>rol</td>
      <% matriz.permisos.forEach((p) => { %><td><%= p.nombre %></td><% }) %>
    </tr>
    <% matriz.roles.forEach((r) => { %>
      <tr>
        <td><%= r.codigo %></td>
        <% r.permisos.forEach((ok) => { %><td><%= ok ? 'sí' : '—' %></td><% }) %>
      </tr>
    <% }) %>
  </table>
  <p class="hint">Se cambian con SQL en las tablas <code>roles</code>, <code>permisos</code> y <code>rol_permisos</code>.</p>
<% } %>

<h2>Usuarios</h2>
<% if (usuarios.length) { %>
  <table>
    <tr><td>código</td><td>usuario</td><td>rol</td><td>activo</td></tr>
    <% usuarios.forEach((u) => { %>
      <tr>
        <td><%= u.codigo %></td>
        <td><%= u.usuario %><br><span class="hint"><%= u.nombre %></span></td>
        <td><%= u.rol %></td>
        <td><%= u.activo ? 'sí' : 'no' %></td>
      </tr>
    <% }) %>
  </table>
<% } else if (!error) { %>
  <p class="hint">La tabla usuarios está vacía.</p>
<% } %>

<a class="btn secondary" href="/">Volver al inicio</a>

<%- include('../partials/footer') %>
