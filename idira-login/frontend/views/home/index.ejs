<%- include('../partials/header', { title: 'Inicio' }) %>

<h1>Bienvenido, <%= user.nombre || user.usuario %></h1>
<p>Ingresaste con: <b><%= user.metodo === 'Base de datos propia' ? 'la base de datos de la app' : 'Idira' %></b>.</p>

<h2>Tus pantallas</h2>
<% if (pantallas.length) { %>
  <p class="hint">Rol en la app: <code><%= rol %></code></p>
  <% pantallas.forEach((p) => { %>
    <a class="btn" href="<%= p.ruta %>"><%= p.titulo %></a>
  <% }) %>
<% } else { %>
  <p class="hint">Tu usuario no tiene un rol con pantallas asignadas en la base de la app.</p>
<% } %>

<table>
  <% Object.entries(user).filter(([, v]) => v).forEach(([k, v]) => { %>
    <tr><td><%= k %></td><td><%= v %></td></tr>
  <% }) %>
</table>

<h2>Usuario en la base de la app</h2>
<% if (interno && interno.error) { %>
  <p class="error"><%= interno.error %></p>
<% } else if (interno) { %>
  <table>
    <tr><td>código</td><td><%= interno.usuario.codigo %></td></tr>
    <tr><td>nombre</td><td><%= interno.usuario.nombre %></td></tr>
    <tr><td>rol</td><td><%= interno.usuario.rol %></td></tr>
    <tr><td>activo</td><td><%= interno.usuario.activo ? 'sí' : 'no' %></td></tr>
    <tr><td>cruzado por</td><td><%= interno.criterio %></td></tr>
  </table>
<% } else { %>
  <p class="hint">No está registrado en la base de datos propia de la app. Idira lo autenticó, pero la app no tiene datos internos de este usuario.</p>
<% } %>

<% if (saml) { %>
  <h2>Datos recibidos de Idira</h2>
  <table>
    <% Object.entries(saml).filter(([k, v]) => v && k !== 'atributos').forEach(([k, v]) => { %>
      <tr><td><%= k %></td><td><%= v %></td></tr>
    <% }) %>
    <% Object.entries(saml.atributos).forEach(([k, v]) => { %>
      <tr><td>Atributo: <%= k %></td><td><%= [].concat(v).join(', ') %></td></tr>
    <% }) %>
  </table>
<% } %>

<% if (esAdmin) { %><a class="btn" href="/admin/migracion">Migrar usuarios a Idira</a><% } %>
<a class="btn secondary" href="/auth/logout">Cerrar sesión</a>

<%- include('../partials/footer') %>
