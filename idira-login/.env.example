# Copia este archivo como .env y completa los valores

# URL pública de la app (en el VPS, con https)
BASE_URL=https://login.tudominio.com
PORT=3000

# Tu tenant de Idira Workforce
#   URL:  la del Admin Portal, sin ruta (ej. https://abc1234.id.cyberark.cloud)
#   ID:   el Tenant ID (ej. ABC1234)
IDIRA_TENANT_URL=
IDIRA_TENANT_ID=

# Cadena aleatoria larga:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- SAML (Idira como IdP) ---
# Datos que entrega Idira al crear la app SAML (pestaña Trust):
#   IdP SSO URL / Single Sign On URL, certificado de firma (descárgalo en certs/) e IdP Entity ID
SAML_IDP_SSO_URL=
SAML_IDP_CERT_FILE=certs/idira-signing.cer
SAML_IDP_ISSUER=
# Opcional: Entity ID de la app (por defecto BASE_URL/auth/saml/metadata)
# SAML_SP_ENTITY_ID=

# --- API de Idira (solo para scripts/crear-usuarios.js) ---
# App web "OAuth2 Client" en Idira (Application ID), usuario de servicio marcado como
# "Is OAuth confidential client" y el scope que da acceso a CDirectoryService/.* y Roles/.*
IDIRA_API_APP_ID=
IDIRA_API_CLIENT_ID=
IDIRA_API_CLIENT_SECRET=
IDIRA_API_SCOPE=
# ID del rol asignado a la app SAML (los usuarios creados se agregan aquí)
IDIRA_API_ROLE_ID=
# Sufijo de login del tenant (Settings > Customization > Suffix), se agrega si el usuario no trae @
IDIRA_LOGIN_SUFFIX=

# --- Base de datos propia de la app (escenario 3) ---
# Postgres con la tabla "usuarios" (ver PRUEBAS.md). En Easypanel el host es el nombre interno del servicio
# DATABASE_URL=postgres://USUARIO:CLAVE@botgv_idira-db:5432/NOMBRE_BD
DATABASE_URL=
