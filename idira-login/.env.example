# Copia este archivo como .env y completa los valores

# URL pública de la app (en el VPS, con https)
BASE_URL=https://login.tudominio.com
PORT=3000

# Tu tenant de Idira Workforce
#   URL:  la del Admin Portal, sin ruta (ej. https://abc1234.id.cyberark.cloud)
#   ID:   el Tenant ID (ej. ABC1234)
IDIRA_TENANT_URL=
IDIRA_TENANT_ID=

# Cadena aleatoria larga:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
