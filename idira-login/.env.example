# Copia este archivo como .env y completa los valores

# URL pública de la app (en el VPS, con https)
BASE_URL=https://login.tudominio.com
PORT=3000

# Tu tenant de Idira Workforce
#   URL:  la del Admin Portal, sin ruta (ej. https://abc1234.id.cyberark.cloud)
#   ID:   el Tenant ID (ej. ABC1234)
IDIRA_TENANT_URL=
IDIRA_TENANT_ID=

# Cadena aleatoria larga:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- SAML (Idira como IdP) ---
# Datos que entrega Idira al crear la app SAML (pestaña Trust):
#   IdP SSO URL / Single Sign On URL, certificado de firma (descárgalo en certs/) e IdP Entity ID
SAML_IDP_SSO_URL=
SAML_IDP_CERT_FILE=certs/idira-signing.cer
SAML_IDP_ISSUER=
# Opcional: Entity ID de la app (por defecto BASE_URL/auth/saml/metadata)
# SAML_SP_ENTITY_ID=
